# Editor defaults for ansible-workstation.
#
# These values deliberately mirror the tooling that already enforces them, so a
# file saved by an editor is never reformatted by CI:
#   * line length 80                         -> ruff and .yamllint
#   * trailing whitespace and final newlines -> pre-commit
#     (trailing-whitespace, end-of-file-fixer)
#   * LF line endings                        -> .gitattributes
#
# Change a value here only together with the tool that owns it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 80

# Ansible content, workflows, pre-commit config.
[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

# Antora extensions.  Not covered by ruff -- keep them small and plain.
[*.js]
indent_size = 2

[*.adoc]
indent_size = 2

# Keep placeholder files genuinely empty.
[.gitkeep]
insert_final_newline = false

# Generated by uv and npm; their wrapping is not ours to choose.
[{uv.lock,requirements.txt,package-lock.json}]
max_line_length = off

# Handlebars overrides for the Antora UI.  Vendored from the upstream bundle
# and kept byte-identical apart from the deliberate edits, so they stay
# diffable against it -- rewrapping them to 80 columns would defeat that.
[*.hbs]
indent_size = 2
max_line_length = off
